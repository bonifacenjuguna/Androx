<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to show the "Show notification" action on Android 13+. Requested only when the user runs something that needs it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets scheduled automations fire at the chosen minute. The user grants this in system settings; without it Androx falls back to inexact alarms. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arms schedules after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the "Vibrate" action and androx.vibrate() buzz the device. Granted automatically. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets conditions ask whether the device is on Wi-Fi. Granted automatically; no network traffic is sent. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The opt-in Listener runs as a foreground service so device events (screen, power, network…) can be delivered. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- "Keep phone awake" holds a wake lock for the length of a run (never more than 10 minutes). Granted automatically. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Set alarm" and "Set timer" create alarms in the Clock app. Granted automatically. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Special access the user grants in system settings, only if a Flow uses "Do Not Disturb", "Set ringer mode: silent". -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Special access the user grants in system settings, only if a Flow changes brightness, screen timeout or auto-rotate. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Needed on Android 11+ so the "Speak" action can find the device's text-to-speech engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Lets "Open app" find an installed app to launch without asking for the list of all apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AndroxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Androx.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Androx.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.AlarmReceiver"
            android:exported="false" />

        <!-- The opt-in Listener (Settings). Only runs while it is allowed and an enabled Flow needs it. -->
        <service
            android:name=".platform.ListenerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for device events such as screen, power, battery and network changes so that the user's own automations can react to them. It runs only when the user turns it on and at least one of their automations needs it." />
        </service>

        <!-- Runs the Flow behind a notification button. Not exported: only Androx's own notifications can reach it. -->
        <receiver
            android:name=".platform.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
